# Core
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
ANTHROPIC_API_KEY=your-upstream-api-key
GATEWAY_API_KEY=your-local-gateway-key
UPSTREAM_URL=https://api.treegpt.cc
UPSTREAM_PROTOCOL=openai
# Optional. Use when the upstream host is only reachable through a local proxy.
# Example: http://127.0.0.1:7897
UPSTREAM_PROXY=
UPSTREAM_TRUST_ENV=false
ENABLE_OPENAI_CACHE_CONTROL=true
ENABLE_ANTHROPIC_CACHE_CONTROL=true
OPENAI_CACHE_TTL=5m
ANTHROPIC_CACHE_TTL=1h
# Anthropic relays may default omitted max_tokens to a small value such as 1024.
ANTHROPIC_DEFAULT_MAX_TOKENS=128000
UPSTREAM_PROVIDER_ORDER_ENABLED=false
# string = {"provider":"Amazon Bedrock"}; order_object = {"provider":{"order":["Amazon Bedrock"]}}.
# JSON array or comma-separated list. For string format, the first provider is sent.
UPSTREAM_PROVIDER_FORMAT=string
UPSTREAM_PROVIDER_ORDER=["Amazon Bedrock"]

# Context window / cold start
# Careful: leaving MAX_CLIENT_MESSAGES empty does NOT fall back to the code
# default (75). An empty value parses as "unset" and silently disables the
# rolling context window and the PWA handoff threshold. Keep a real number.
MAX_CLIENT_MESSAGES=75
ENABLE_COLD_START=true
# Optional fallback threshold used only when MAX_CLIENT_MESSAGES is unset;
# empty is a valid state here.
COLD_START_MESSAGE_LIMIT=
COLD_START_IDLE_MINUTES=120

# Mem note layer
INJECT_MEM_NOTES=false
ENABLE_INLINE_MEMORY_CAPTURE=false

# Injection and tools
INJECT_META_SUMMARIES=true
WAKE_WELCOME_MESSAGE=
HEARTBEAT_INJECT_EVERY=5
# Upload settled Heartbeats to Supabase. Remote soft-delete reconciliation is
# intentionally separate; enable it only on the production instance with its
# stable persistent SQLite volume.
ENABLE_HEARTBEAT_ARCHIVE=true
HEARTBEAT_ARCHIVE_RECONCILE_DELETIONS=false
ENABLE_GATEWAY_TOOLS=false
ENABLE_MEM0_MANAGEMENT_TOOLS=false
EXPOSE_SUPABASE_TOOLS=true
# broker = expose one compact shenyu_gateway_tool; full = expose each gateway tool schema.
GATEWAY_TOOL_MODE=broker
MAX_INTERNAL_TOOL_ROUNDS=3

# Recall index. Keep request-time rebuild off unless a slower first recall is acceptable.
ENABLE_RECALL_AUTO_SYNC=false
RECALL_CANDIDATE_LIMIT=160
RECALL_VECTOR_MIN_SCORE=0.42
# Periodically reconcile source tables into shenyu_recall_index. This is the
# normal freshness path; request-time auto sync remains an emergency fallback.
ENABLE_RECALL_SYNC_WORKER=true
RECALL_SYNC_WORKER_INTERVAL_SECONDS=900

# Recall embeddings. SiliconFlow BAAI/bge-m3 returns vector(1024).
ENABLE_RECALL_EMBEDDINGS=false
ENABLE_RECALL_EMBEDDING_WORKER=true
RECALL_EMBEDDING_WORKER_INTERVAL_SECONDS=900
RECALL_EMBEDDING_WORKER_BATCH_SIZE=50
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Local store
GATEWAY_DB_PATH=./data/shenyu_gateway.db
# 完整请求日志（Messages/Upstream/Response）默认关闭，仅进程内最近 30 条；也可在 Admin 配置页随时开关
GATEWAY_LOG_FULL_PAYLOADS=false
GATEWAY_MESSAGE_RETENTION=1500
GATEWAY_CONTEXT_SNAPSHOT_RETENTION=3
GATEWAY_COLD_START_RETENTION=20
GATEWAY_REQUEST_LOG_RETENTION=200
