# Core
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
ANTHROPIC_API_KEY=your-upstream-api-key
GATEWAY_API_KEY=your-local-gateway-key
UPSTREAM_URL=https://api.treegpt.cc
UPSTREAM_PROTOCOL=openai
# Optional. Use when the upstream host is only reachable through a local proxy.
# Example: http://127.0.0.1:7897
UPSTREAM_PROXY=
UPSTREAM_TRUST_ENV=false
HISENSE_UPSTREAM_URL=
HISENSE_API_KEY=
HISENSE_PROTOCOL=

# Calendar layer
CALENDAR_UPSTREAM_URL=
CALENDAR_API_KEY=
CALENDAR_PROTOCOL=auto
CALENDAR_MODEL=claude-opus-4-7

# Context window / cold start
MAX_CLIENT_MESSAGES=
ENABLE_COLD_START=true
COLD_START_MESSAGE_LIMIT=
COLD_START_IDLE_MINUTES=120

# Atomic memory layer
INJECT_ATOMIC_MEMORIES=false
ENABLE_INLINE_MEMORY_CAPTURE=false
DEFAULT_ATOMIC_MEMORY_LIMIT=3
ATOMIC_MEMORY_MIN_SCORE=0.55

# Injection and tools
INJECT_META_SUMMARIES=true
WAKE_WELCOME_MESSAGE=
INJECT_SURFACE_PASSAGES=true
DEFAULT_SURFACE_LIMIT=3
HEARTBEAT_INJECT_EVERY=5
ENABLE_GATEWAY_TOOLS=false
EXPOSE_SUPABASE_TOOLS=true
# broker = expose one compact shenyu_gateway_tool; full = expose each gateway tool schema.
GATEWAY_TOOL_MODE=broker
MAX_INTERNAL_TOOL_ROUNDS=3
HISENSE_CLIENT_NAME=hisense
HISENSE_HEARTBEAT_LIMIT=3
HISENSE_NOTEBOOK_LIMIT=5

# Local store
GATEWAY_DB_PATH=./data/shenyu_gateway.db
GATEWAY_LOG_FULL_PAYLOADS=true
GATEWAY_MESSAGE_RETENTION=1500
GATEWAY_CONTEXT_SNAPSHOT_RETENTION=3
GATEWAY_COLD_START_RETENTION=20
GATEWAY_SURFACE_EVENT_RETENTION=500
