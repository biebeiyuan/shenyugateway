    "calendar": {
      "title": "日历日记",
      "summary": "给未来几天、几周、几个月的自己接上连续性的骨架。",
      "core": [
        "按 day、week、month 生成并读取最新页面。",
        "上下文只注入正文，不用摘要或 digest 冒充连续性。"
      ],
      "resident_effect": "三天后的自己能接上发生过什么，但感受不必被塞进日历。",
