      }
    },
    "mem": {
      "title": "Mem",
      "summary": "保存未来某个具体时刻可能需要被戳到的钩子和事实便签。",
      "core": [
        "通过人、地、物等窄锚点优先匹配，语义召回只作为有锚支持的补充。",
        "最终和 Stars 一起进入 Memory Island；已解决的承诺不会自动浮现。"
      ],
      "resident_effect": "名字、承诺和具体事实有机会在需要的时刻回来，但不会把所有便签铺满当前对话。",
      "source_globs": [
        "shenyu_gateway/mem_notes/**/*.py",
        "shenyu_gateway/memory_island.py",
        "shenyu_gateway/context_builder.py"
      ],
