  "schema_version": 1,
  "components": {
    "stars": {
      "title": "星星库",
      "summary": "保存当场响起的联想记忆，再用 Memory Island 让少量相关星星稳定浮现。",
      "core": [
        "六通道加权 RRF：正文、关键词、和弦、关系、场景、明确点名。",
        "Memory Island 用 2/3 重合门保持连续；明确点名可以走窄的逃生门。",
        "没有相关星星时可以空召回，不为了填满数量硬塞。"
      ],
      "resident_effect": "星星不会每轮乱跳；真正当场响过的东西才有机会回到眼前。",
      "source_globs": [
        "shenyu_gateway/stars/**/*.py",
        "shenyu_gateway/memory_island.py",
        "shenyu_gateway/context_builder.py"
      ],
      "config_keys": [
        "inject_stars",
        "star_inject_limit",
        "star_related_min_score",
        "star_soft_direct_cooldown_turns",
        "star_ranker_version"
      ],
      "reviewed": {
