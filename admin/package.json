{
  "name": "shenyu-gateway-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:install:mirror": "env PLAYWRIGHT_DOWNLOAD_HOST=https://registry.npmmirror.com/-/binary/playwright npm run test:e2e:install"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "naive-ui": "^2.40.0",
    "three": "^0.184.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
